digraph list {
  graph [dpi=100, bgcolor="#1B1F24", splines=ortho, pad=0.5, nodesep=2.4, ranksep=1.5];
  node  [shape=rectangle, style="rounded,filled", fontcolor="#E6EDF3", fontsize=16, width=1.8, height=1.7, fixedsize=true, penwidth=3];
  edge  [penwidth=2, arrowsize=1.0];
  cell0 [fillcolor="#5e4592", color="#B392F0", label="header\n\nhead: 4\ntail: 1\nfree: 5"];
  cell1 [fillcolor="#2F5D8A", color="#6CA6E0", label="idx: 1 [TAIL]\n\n99.000000\nnxt: 0\nprv: 2"];
  cell2 [fillcolor="#2F5D8A", color="#6CA6E0", label="idx: 2\n\n20.000000\nnxt: 1\nprv: 3"];
  cell3 [fillcolor="#2F5D8A", color="#6CA6E0", label="idx: 3\n\n15.000000\nnxt: 2\nprv: 4"];
  cell4 [fillcolor="#2F5D8A", color="#6CA6E0", label="idx: 4 [HEAD]\n\n5.000000\nnxt: 3\nprv: 0"];
  cell5 [fillcolor="#2B3036", color="#6E7681", style="rounded,filled,dashed", label="idx: 5\n\n-1.000000\nnxt: 6\nprv: -1"];
  cell6 [fillcolor="#2B3036", color="#6E7681", style="rounded,filled,dashed", label="idx: 6\n\n-1.000000\nnxt: 7\nprv: -1"];
  cell7 [fillcolor="#2B3036", color="#6E7681", style="rounded,filled,dashed", label="idx: 7\n\n-1.000000\nnxt: 0\nprv: -1"];
  { rank=same; cell0; cell1; cell2; cell3; cell4; cell5; cell6; cell7; }
  cell0 -> cell1 [style=invis, weight=100];
  cell1 -> cell2 [style=invis, weight=100];
  cell2 -> cell3 [style=invis, weight=100];
  cell3 -> cell4 [style=invis, weight=100];
  cell4 -> cell5 [style=invis, weight=100];
  cell5 -> cell6 [style=invis, weight=100];
  cell6 -> cell7 [style=invis, weight=100];
  cell0 -> cell4 [color="#3FB950"];
  cell0 -> cell1 [color="#F0883E"];
  cell1 -> cell0 [color="#3FB950"];
  cell1 -> cell2 [color="#F0883E"];
  cell2 -> cell1 [color="#3FB950"];
  cell2 -> cell3 [color="#F0883E"];
  cell3 -> cell2 [color="#3FB950"];
  cell3 -> cell4 [color="#F0883E"];
  cell4 -> cell3 [color="#3FB950"];
  cell4 -> cell0 [color="#F0883E"];
  cell5 -> cell6 [color="#8B949E", style=dashed];
  cell6 -> cell7 [color="#8B949E", style=dashed];
  cell7 -> cell0 [color="#8B949E", style=dashed];
  cell0 -> cell5 [color="#D29922", penwidth=3, style=bold];
}
